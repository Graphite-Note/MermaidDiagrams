!.swiftpm/xcode/xcshareddata/xcschemes/
.swiftpm/xcode/xcshareddata/xcschemes/*
!.swiftpm/xcode/xcshareddata/xcschemes/MermaidDiagramsDeviceBenchmark.xcscheme
DerivedData/
xcuserdata/
*.xcuserstate
.DS_Store
